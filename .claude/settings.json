{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm check*)",
      "Bash(pnpm install*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm exec tsc*)",
      "Bash(node scripts/*)",
      "Bash(git *)",
      "Bash(gh *)",
      "PowerShell(pnpm check*)",
      "PowerShell(pnpm install*)",
      "PowerShell(pnpm dev*)",
      "PowerShell(pnpm build*)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm exec vitest*)",
      "PowerShell(pnpm exec tsc*)",
      "PowerShell(node scripts/*)",
      "PowerShell(git *)",
      "PowerShell(gh *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push *--no-verify*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm dlx*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(pnpm lint*)",
      "PowerShell(pnpm dlx*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/check.mjs", "--hook"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
